#!/bin/bash
# ─────────────────────────────────────────────────────────
# dwm-controlcenter — Rofi-based Control Center for dwm-tudor
# Launch with SUPER+F1 or run directly from a terminal.
# Provides: system health checks, quick actions, keybind
# viewer, appearance settings, and system info.
# ─────────────────────────────────────────────────────────
set -euo pipefail

# ── Paths ────────────────────────────────────────────────
# Prefer installed location, fall back to repo checkout
if [ -d "$HOME/.config/rofi/themes" ]; then
    THEME_DIR="$HOME/.config/rofi/themes"
elif [ -d "$HOME/.local/share/dwm-tudor/config/rofi/themes" ]; then
    THEME_DIR="$HOME/.local/share/dwm-tudor/config/rofi/themes"
else
    THEME_DIR="$(cd "$(dirname "$0")/../config/rofi/themes" 2>/dev/null && pwd)" || THEME_DIR=""
fi

THEME_FILE="${THEME_DIR:+$THEME_DIR/controlcenter.rasi}"

DWM_TITUS_DIR="$HOME/.local/share/dwm-tudor"
POLYBAR_DIR="$HOME/.config/polybar"
ROFI_DIR="$HOME/.config/rofi"
BG_DIR="$HOME/Pictures/backgrounds"

# ── Terminal detection ───────────────────────────────────
detect_terminal() {
    for t in ghostty alacritty kitty st xterm; do
        if command -v "$t" &>/dev/null; then
            echo "$t"
            return
        fi
    done
    echo "xterm"
}

TERM_CMD="$(detect_terminal)"

spawn_terminal() {
    case "$TERM_CMD" in
        ghostty)    ghostty -e "$@" &  ;;
        alacritty)  alacritty -e "$@" & ;;
        kitty)      kitty "$@" &        ;;
        *)          "$TERM_CMD" -e "$@" & ;;
    esac
}

# ── Colours: follow the polybar theme ────────────────────
# polybar's colors.ini is generated by theme-apply.sh from themes.toml, so reading
# it keeps the Control Center in sync with the bar on every theme switch.
# controlcenter.rasi ships Nord defaults; these values override them at launch.
POLYBAR_COLORS="${XDG_CONFIG_HOME:-$HOME/.config}/polybar/themes/minimal/colors.ini"
C_URGENT="#bf616a"     # colour of failed items in System Health (polybar "red")
THEME_STR=""           # rofi -theme-str override built by load_colors

load_colors() {
    local line bg="" bg_alt="" fg="" fg_alt="" accent="" urgent=""
    # Only plain #RRGGBB values: polybar's #AARRGGBB would be misread by rofi
    local re='^[[:space:]]*(bg|fg|bg-alt|fg-alt|blue|red)[[:space:]]*=[[:space:]]*(#[0-9A-Fa-f]{6})([^0-9A-Fa-f]|$)'
    THEME_STR=""
    if [ ! -r "$POLYBAR_COLORS" ]; then return 0; fi
    while IFS= read -r line || [ -n "$line" ]; do
        if [[ "$line" =~ $re ]]; then
            case "${BASH_REMATCH[1]}" in
                bg)     bg="${BASH_REMATCH[2]}" ;;
                fg)     fg="${BASH_REMATCH[2]}" ;;
                bg-alt) bg_alt="${BASH_REMATCH[2]}" ;;
                fg-alt) fg_alt="${BASH_REMATCH[2]}" ;;
                blue)   accent="${BASH_REMATCH[2]}" ;;
                red)    urgent="${BASH_REMATCH[2]}" ;;
            esac
        fi
    done < "$POLYBAR_COLORS"
    if [ -n "$urgent" ]; then C_URGENT="$urgent"; fi
    if [ -n "$bg" ];     then THEME_STR+=" bg: $bg;"; fi
    if [ -n "$bg_alt" ]; then THEME_STR+=" bg-alt: $bg_alt;"; fi
    if [ -n "$fg" ];     then THEME_STR+=" fg: $fg;"; fi
    if [ -n "$fg_alt" ]; then THEME_STR+=" fg-alt: $fg_alt;"; fi
    if [ -n "$accent" ]; then THEME_STR+=" accent: $accent;"; fi
    if [ -n "$THEME_STR" ]; then THEME_STR="* {${THEME_STR} }"; fi
    return 0
}

# ── Rofi helpers ─────────────────────────────────────────
rofi_menu() {
    local prompt="$1" mesg="${2:-}"
    shift 2
    local args=(-dmenu -i -p "$prompt" -theme "$THEME_FILE" -kb-row-left "" -kb-move-char-back "" -kb-custom-1 "Left")
    load_colors
    if [ -n "$THEME_STR" ]; then args+=(-theme-str "$THEME_STR"); fi
    [ -n "$mesg" ] && args+=(-mesg "$mesg")
    local ret=0
    rofi "${args[@]}" "$@" || ret=$?
    # ret 0 = selected, 1 = escape, 10 = custom-1 (left arrow)
    if [ "$ret" -eq 10 ] || [ "$ret" -eq 1 ]; then
        return 1
    fi
    return 0
}

notify() {
    if command -v notify-send &>/dev/null; then
        notify-send -a "DWM Control Center" "$@" 2>/dev/null || true
    fi
}

# ── Distro detection (/etc/os-release) ───────────────────
# Sets DISTRO_FAMILY (arch | debian | fedora | unknown) and DISTRO_NAME.
# Derivatives are matched through ID_LIKE (Ubuntu, Mint, Manjaro, Rocky...).
DISTRO_FAMILY="unknown"
DISTRO_NAME="Unknown"

detect_distro() {
    local osr="" f id="" like="" pretty="" tok
    for f in /etc/os-release /usr/lib/os-release; do
        if [ -r "$f" ]; then osr="$f"; break; fi
    done
    if [ -n "$osr" ]; then
        # Read in subshells so os-release variables don't leak into this script
        id="$(. "$osr" 2>/dev/null; echo "${ID:-}")" || id=""
        like="$(. "$osr" 2>/dev/null; echo "${ID_LIKE:-}")" || like=""
        pretty="$(. "$osr" 2>/dev/null; echo "${PRETTY_NAME:-}")" || pretty=""
    fi
    DISTRO_NAME="${pretty:-${id:-Unknown}}"
    DISTRO_FAMILY="unknown"
    for tok in $id $like; do
        case "$tok" in
            arch|archarm|manjaro|endeavouros|cachyos|garuda|artix)
                DISTRO_FAMILY="arch"; break ;;
            debian|ubuntu|linuxmint|pop|raspbian|kali|zorin|elementary|neon)
                DISTRO_FAMILY="debian"; break ;;
            fedora|rhel|centos|rocky|almalinux|nobara)
                DISTRO_FAMILY="fedora"; break ;;
        esac
    done
    return 0
}
detect_distro

# Installer script that matches the detected distro (empty if unsupported)
installer_script() {
    case "$DISTRO_FAMILY" in
        arch)   echo "install-arch.sh"   ;;
        debian) echo "install-debian.sh" ;;
        fedora) echo "install-fedora.sh" ;;
    esac
    return 0
}

# Print the dwm-tudor directory (install dir or repo checkout) containing $1
find_repo_file() {
    local rel="$1" self dir
    self="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
    for dir in "$DWM_TITUS_DIR" "$self/.."; do
        if [ -f "$dir/$rel" ]; then
            (cd "$dir" && pwd)
            return 0
        fi
    done
    return 1
}

run_installer() {
    local script dir
    script="$(installer_script)"
    if [ -z "$script" ]; then
        notify "No installer for $DISTRO_NAME" "Supported: Arch, Debian/Ubuntu, Fedora" --urgency=critical
        return 0
    fi
    if ! dir="$(find_repo_file "$script")"; then
        notify "$script not found" "Clone https://github.com/tudorioan1/dwm-tudor first" --urgency=critical
        return 0
    fi
    spawn_terminal bash -c 'cd "$1" && bash "./$2"; echo; echo "Press Enter to close"; read -r' _ "$dir" "$script"
}

run_check_deps() {
    local dir
    if ! dir="$(find_repo_file "scripts/check-deps.sh")"; then
        notify "scripts/check-deps.sh not found" --urgency=critical
        return 0
    fi
    spawn_terminal bash -c 'cd "$1" && bash scripts/check-deps.sh; echo; echo "Press Enter to close"; read -r' _ "$dir"
}

# ═════════════════════════════════════════════════════════
# HEALTH CHECK MODULE
# ═════════════════════════════════════════════════════════

run_health_check() {
    load_colors
    local pass=0 fail=0 passed_lines=() failed_lines=()

    # -- helper: check if a command exists --
    _cmd() {
        if command -v "$1" &>/dev/null; then
            passed_lines+=("✓  $1")
            pass=$((pass + 1))
        else
            failed_lines+=("<span color='${C_URGENT}'>✗  $1  (missing)</span>")
            fail=$((fail + 1))
        fi
    }

    # -- helpers: record a pass / fail --
    _ok()  { passed_lines+=("✓  $1"); pass=$((pass + 1)); }
    _bad() { failed_lines+=("<span color='${C_URGENT}'>✗  $1</span>"); fail=$((fail + 1)); }

    # -- helper: is a package installed? (uses the detected distro's package manager) --
    _pkg_installed() {
        case "$DISTRO_FAMILY" in
            arch)   pacman -Qi "$1" &>/dev/null ;;
            debian) [[ "$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null)" == "install ok installed" ]] ;;
            fedora) rpm -q "$1" &>/dev/null ;;
            *)      return 1 ;;
        esac
    }

    # -- helper: list all installed package names (one per line) --
    _list_pkgs() {
        case "$DISTRO_FAMILY" in
            arch)   pacman -Qq 2>/dev/null ;;
            debian) dpkg-query -W -f='${Package}\n' 2>/dev/null ;;
            fedora) rpm -qa --qf '%{NAME}\n' 2>/dev/null ;;
        esac
        return 0
    }

    # -- helper: package check with per-distro names --
    #    _dep <arch name> <debian name> <fedora name> [pkg-config module]
    #    "a|b" = alternative names (first found wins), "-" = not needed on that distro.
    #    Unknown distro: falls back to the pkg-config module if one is given.
    _dep() {
        local arch_n="$1" deb_n="$2" fed_n="$3" pc="${4:-}" names="" alt found="" alts=()
        case "$DISTRO_FAMILY" in
            arch)   names="$arch_n" ;;
            debian) names="$deb_n"  ;;
            fedora) names="$fed_n"  ;;
            *)
                if [ -n "$pc" ] && command -v pkg-config &>/dev/null; then
                    if pkg-config --exists "$pc" 2>/dev/null; then
                        _ok "$pc  (pkg-config)"
                    else
                        _bad "$pc  (not found)"
                    fi
                fi
                return 0
                ;;
        esac
        if [ "$names" = "-" ]; then return 0; fi
        IFS='|' read -ra alts <<<"$names"
        for alt in "${alts[@]}"; do
            if _pkg_installed "$alt"; then found="$alt"; break; fi
        done
        if [ -n "$found" ]; then
            _ok "$found"
        else
            _bad "${alts[0]}  (not installed)"
        fi
        return 0
    }

    # -- helper: any of several commands satisfies the check --
    _cmd_any() {
        local label="$1" c
        shift
        for c in "$@"; do
            if command -v "$c" &>/dev/null; then _ok "$label"; return 0; fi
        done
        _bad "$label  (missing)"
        return 0
    }

    # -- helper: check if a font is present --
    _font() {
        local result
        result=$(fc-list : family 2>/dev/null || true)
        local lower="${result,,}"
        local query="${1,,}"
        if [[ "$lower" == *"$query"* ]]; then
            passed_lines+=("✓  $1")
            pass=$((pass + 1))
        else
            failed_lines+=("<span color='${C_URGENT}'>✗  $1  (not found)</span>")
            fail=$((fail + 1))
        fi
    }

    # -- helper: check if a process is running --
    _proc() {
        if pgrep -x "$1" &>/dev/null; then
            passed_lines+=("✓  $1  (running)")
            pass=$((pass + 1))
        else
            failed_lines+=("<span color='${C_URGENT}'>✗  $1  (not running)</span>")
            fail=$((fail + 1))
        fi
    }

    # -- helper: check if a file/dir exists --
    _path() {
        if [ -e "$1" ]; then
            passed_lines+=("✓  $1")
            pass=$((pass + 1))
        else
            failed_lines+=("<span color='${C_URGENT}'>✗  $1  (missing)</span>")
            fail=$((fail + 1))
        fi
    }

    # ── Build dependencies ───────────────────────────────
    _cmd cc
    _cmd make
    #    arch         debian                                     fedora             pkg-config
    _dep libx11       libx11-dev                                 libX11-devel       x11
    _dep libxft      libxft-dev                                 libXft-devel       xft
    _dep libxinerama libxinerama-dev                            libXinerama-devel  xinerama
    _dep imlib2      libimlib2-dev                              imlib2-devel       imlib2
    _dep libxcb      libxcb1-dev                                libxcb-devel       xcb
    _dep freetype2   "libfreetype-dev|libfreetype6-dev"         freetype-devel     freetype2
    _dep fontconfig  "libfontconfig-dev|libfontconfig1-dev"     fontconfig-devel   fontconfig
    # Debian splits these out of libx11/libxcb (dwm.c needs Xlib-xcb.h and xcb/res.h)
    _dep -           libx11-xcb-dev                             -                  x11-xcb
    _dep -           libxcb-res0-dev                            -                  xcb-res
    _dep -           libxcb-util-dev                            xcb-util-devel     xcb-util

    # ── Xorg / Xlibre ─────────────────────────────────────
    # Detect Xlibre by any installed xlibre* package (server, drivers, etc.)
    local all_pkgs xlibre_pkg="" xorg_pkg=""
    all_pkgs="$(_list_pkgs)"
    xlibre_pkg="$(grep -m1 '^xlibre' <<<"$all_pkgs" || true)"
    case "$DISTRO_FAMILY" in
        arch)   xorg_pkg="xorg-server" ;;
        debian) xorg_pkg="xserver-xorg-core" ;;
        fedora) xorg_pkg="xorg-x11-server-Xorg" ;;
    esac
    if [ -n "$xlibre_pkg" ]; then
        _ok "Xlibre detected ($xlibre_pkg)"
    elif [ -n "$xorg_pkg" ] && _pkg_installed "$xorg_pkg"; then
        _ok "$xorg_pkg"
    elif command -v Xorg &>/dev/null; then
        _ok "Xorg"
    else
        _bad "xorg server or xlibre  (not installed)"
    fi
    # X utilities: checked by command so it works the same on every distro
    # (Arch: xorg-xinit/xrandr/xset/xsetroot · Debian: xinit, x11-xserver-utils · Fedora: xorg-x11-xinit, xrandr, xset, xsetroot)
    _cmd xinit
    _cmd xrandr
    _cmd xset
    _cmd xsetroot

    # ── Core Runtime ─────────────────────────────────────
    _cmd rofi
    _cmd picom
    _cmd dunst
    _cmd feh
    _cmd flameshot
    _cmd_any dex dex dex-autostart   # Fedora's package ships the binary as dex-autostart
    _cmd amixer
    _cmd polybar

    # ── Terminal Emulators ───────────────────────────────
    local term_ok=0
    for t in ghostty alacritty kitty st; do
        if command -v "$t" &>/dev/null; then
            passed_lines+=("✓  $t")
            pass=$((pass + 1)); term_ok=$((term_ok + 1))
        fi
    done
    if [ "$term_ok" -eq 0 ]; then
        failed_lines+=("<span color='${C_URGENT}'>✗  No supported terminal found</span>")
        fail=$((fail + 1))
    fi

    # ── Fonts ────────────────────────────────────────────
    _font "JetBrainsMono Nerd"
    _font "Noto Color Emoji"

    # ── Running Services ─────────────────────────────────
    _proc picom
    _proc dunst
    _proc polybar
    if systemctl is-active --quiet NetworkManager 2>/dev/null; then
        passed_lines+=("✓  NetworkManager  (active)")
        pass=$((pass + 1))
    else
        failed_lines+=("<span color='${C_URGENT}'>✗  NetworkManager  (inactive)</span>")
        fail=$((fail + 1))
    fi

    # ── Session & Config Files ───────────────────────────
    _path /usr/share/xsessions/dwm.desktop
    _path "$HOME/.xinitrc"
    _path "$POLYBAR_DIR"
    _path "$ROFI_DIR"
    _path "$BG_DIR"

    # ── Display results (failed first, then passed) ──────
    local total=$((pass + fail))
    local distro_label="$DISTRO_NAME"
    distro_label="${distro_label//&/&amp;}"; distro_label="${distro_label//</&lt;}"; distro_label="${distro_label//>/&gt;}"
    local summary="$distro_label  ·  $pass/$total checks passed"
    if [ "$fail" -gt 0 ]; then
        summary="$summary  ·  <span color='${C_URGENT}'>$fail issues found</span>"
    fi
    if [ "$DISTRO_FAMILY" = "unknown" ]; then
        summary="$summary  ·  unknown distro, package checks via pkg-config"
    fi

    local all_lines=()
    if [ "${#failed_lines[@]}" -gt 0 ]; then
        all_lines+=("─── Failed ───")
        all_lines+=("${failed_lines[@]}")
    fi
    if [ "${#passed_lines[@]}" -gt 0 ]; then
        all_lines+=("─── Passed ───")
        all_lines+=("${passed_lines[@]}")
    fi

    while true; do
        local chosen
        chosen=$(printf '%s\n' "${all_lines[@]}" | rofi_menu "  System Health" "$summary" -no-custom -markup-rows) || break

        # If user selected a failing item, offer to run the installer for this distro
        if [[ "$chosen" == *"✗"* ]]; then
            local installer fix_items=() action
            installer="$(installer_script)"
            if [ -n "$installer" ]; then
                fix_items+=("Run $installer (auto-fix)")
            fi
            fix_items+=("Run check-deps.sh (details)")
            action=$(printf '%s\n' "${fix_items[@]}" \
                | rofi_menu "  Fix" "Selected: $chosen") || continue
            case "$action" in
                "Run install-"*)   run_installer   ;;
                "Run check-deps"*) run_check_deps ;;
            esac
        fi
    done
}

# ═════════════════════════════════════════════════════════
# QUICK ACTIONS MODULE
# ═════════════════════════════════════════════════════════

run_quick_actions() {
    local items=(
        "  Restart Picom"
        "  Restart Dunst"
        "  Restart Polybar"
        "  Reload Wallpaper"
        "  Toggle Compositor"
        "  Restart NetworkManager"
        "  Run Dependency Check"
        "  Install Missing Deps"
    )

    while true; do
    local chosen
    chosen=$(printf '%s\n' "${items[@]}" | rofi_menu "  Quick Actions" "Esc / ← to go back") || break

    case "$chosen" in
        *"Restart Picom"*)
            pkill picom 2>/dev/null || true
            sleep 0.3
            picom -b &
            notify "Picom restarted"
            ;;
        *"Restart Dunst"*)
            pkill dunst 2>/dev/null || true
            sleep 0.3
            dunst &
            notify "Dunst restarted"
            ;;
        *"Restart Polybar"*)
            if [ -x "$POLYBAR_DIR/launch.sh" ]; then
                "$POLYBAR_DIR/launch.sh" &
            else
                notify "Polybar launch.sh not found" --urgency=critical
            fi
            ;;
        *"Reload Wallpaper"*)
            if [ -d "$BG_DIR" ]; then
                feh --randomize --bg-fill "$BG_DIR"/* || notify "Failed to set wallpaper" --urgency=critical
                notify "Wallpaper randomized"
            else
                notify "No wallpapers in $BG_DIR" --urgency=critical
            fi
            ;;
        *"Toggle Compositor"*)
            if pgrep -x picom &>/dev/null; then
                pkill picom 2>/dev/null || true
                notify "Compositor stopped"
            else
                picom -b &
                notify "Compositor started"
            fi
            ;;
        *"Restart NetworkManager"*)
            spawn_terminal bash -c "sudo systemctl restart NetworkManager && echo 'NetworkManager restarted'; sleep 2"
            ;;
        *"Run Dependency Check"*)
            run_check_deps
            ;;
        *"Install Missing Deps"*)
            run_installer
            ;;
    esac
    done
}

# ═════════════════════════════════════════════════════════
# THEME SELECT MODULE
# ═════════════════════════════════════════════════════════

run_theme_select() {
    local themes_file="$HOME/.local/share/dwm-tudor/config/themes.toml"
    [ ! -f "$themes_file" ] && themes_file="$HOME/.config/dwm-tudor/themes.toml"

    if [ ! -f "$themes_file" ]; then
        notify "themes.toml not found" --urgency=critical
        return
    fi

    # Read available theme names from [theme.xxx] headers
    local themes=()
    while IFS= read -r line; do
        if [[ "$line" =~ ^\[theme\.([a-zA-Z0-9_-]+)\] ]]; then
            themes+=("${BASH_REMATCH[1]}")
        fi
    done < "$themes_file"

    if [ "${#themes[@]}" -eq 0 ]; then
        notify "No themes found in themes.toml" --urgency=critical
        return
    fi

    # Get current active theme
    local current
    current=$(awk '/^\[active\]/{found=1} found && /^theme[[:space:]]*=/{split($0,q,"\""); print q[2]; exit}' "$themes_file")

    # Build display list (mark active theme)
    local display=()
    for t in "${themes[@]}"; do
        if [ "$t" = "$current" ]; then
            display+=("  $t  (active)")
        else
            display+=("  $t")
        fi
    done

    local chosen
    chosen=$(printf '%s\n' "${display[@]}" | rofi_menu "  Select Theme" "Current: $current · Esc / ← to go back") || return

    # Extract theme name (strip icon prefix and status suffix)
    local selected
    selected=$(echo "$chosen" | sed 's/^[[:space:]]*//' | awk '{print $1}')

    [ "$selected" = "$current" ] && return

    # Update theme = "..." under [active] in place
    awk -v new="$selected" '
        /^\[active\]/{found=1}
        found && /^theme[[:space:]]*=/{sub(/"[^"]*"/, "\"" new "\""); found=0}
        {print}
    ' "$themes_file" > "${themes_file}.tmp" && mv "${themes_file}.tmp" "$themes_file"

    notify "Theme: $selected" "Applying…"
    sleep 1
}

# ═════════════════════════════════════════════════════════
# APPEARANCE MODULE
# ═════════════════════════════════════════════════════════

run_appearance() {
    local items=(
        "  Select Theme"
        "  Randomize Wallpaper"
        "  Open Wallpaper Folder"
        "  Edit Polybar Config"
        "  GTK Theme Settings"
    )

    while true; do
    local chosen
    chosen=$(printf '%s\n' "${items[@]}" | rofi_menu "  Appearance" "Esc / ← to go back") || break

    case "$chosen" in
        *"Select Theme"*)
            run_theme_select
            ;;
        *"Randomize Wallpaper"*)
            if [ -d "$BG_DIR" ]; then
                feh --randomize --bg-fill "$BG_DIR"/* || notify "Failed to set wallpaper" --urgency=critical
                notify "Wallpaper randomized"
            else
                notify "No wallpapers in $BG_DIR" --urgency=critical
            fi
            ;;
        *"Open Wallpaper Folder"*)
            xdg-open "$BG_DIR" 2>/dev/null &
            disown
            ;;
        *"Edit Polybar Config"*)
            local cfg="$POLYBAR_DIR/themes/minimal/config.ini"
            if [ -f "$cfg" ]; then
                xdg-open "$cfg" 2>/dev/null &
                disown
            else
                notify "Polybar config not found" --urgency=critical
            fi
            ;;
        *"GTK Theme Settings"*)
            if command -v nwg-look &>/dev/null; then
                setsid nwg-look </dev/null >/dev/null 2>&1 &
            else
                notify "nwg-look is not installed" --urgency=critical
            fi
            ;;
    esac
    done
}

# ═════════════════════════════════════════════════════════
# SYSTEM INFO MODULE
# ═════════════════════════════════════════════════════════

run_system_info() {
    local info_lines=()

    # DWM version
    local dwm_ver
    dwm_ver=$(dwm -v 2>&1 | head -1) || dwm_ver="dwm (version unknown)"
    info_lines+=("DWM:  $dwm_ver")

    # Kernel
    info_lines+=("Kernel:  $(uname -sr)")

    # Hostname
    info_lines+=("Host:  $(hostname)")

    # Uptime
    info_lines+=("Uptime:  $(uptime -p 2>/dev/null | sed 's/up //')")

    # Terminal
    info_lines+=("Terminal:  $TERM_CMD")

    # Compositor
    if pgrep -x picom &>/dev/null; then
        info_lines+=("Compositor:  picom (active)")
    else
        info_lines+=("Compositor:  none")
    fi

    # Audio server
    if pgrep -x pipewire &>/dev/null; then
        info_lines+=("Audio:  PipeWire")
    elif pgrep -x pulseaudio &>/dev/null; then
        info_lines+=("Audio:  PulseAudio")
    else
        info_lines+=("Audio:  unknown")
    fi

    # Current wallpaper
    if [ -f "$HOME/.fehbg" ]; then
        local wp
        wp=$(command grep -oP "(?<=').*(?=')" "$HOME/.fehbg" 2>/dev/null | tail -1) || wp="unknown"
        info_lines+=("Wallpaper:  ${wp##*/}")
    fi

    # Display
    if command -v xrandr &>/dev/null; then
        local monitors
        monitors=$(xrandr --query 2>/dev/null | command grep -c " connected") || monitors=0
        info_lines+=("Monitors:  $monitors")
    fi

    printf '%s\n' "${info_lines[@]}" | rofi_menu "  System Info" "Esc / ← to go back" -no-custom || true
}

# ═════════════════════════════════════════════════════════
# MAIN MENU
# ═════════════════════════════════════════════════════════

main_menu() {
    local items=(
        "  System Health"
        "  Quick Actions"
        "  Keybindings"
        "  Appearance"
        "  System Info"
    )

    while true; do
        local chosen
        chosen=$(printf '%s\n' "${items[@]}" | rofi_menu "  DWM Control Center" "dwm-tudor · SUPER+F1") || break

        case "$chosen" in
            *"System Health"*)  run_health_check   ;;
            *"Quick Actions"*)  run_quick_actions   ;;
            *"Keybindings"*)
                if command -v dwm-keybinds &>/dev/null; then
                    dwm-keybinds
                else
                    # Try repo-local copy
                    local kb
                    kb="$(dirname "$0")/dwm-keybinds"
                    if [ -x "$kb" ]; then
                        "$kb"
                    else
                        notify "dwm-keybinds not found" --urgency=critical
                    fi
                fi
                ;;
            *"Appearance"*)     run_appearance      ;;
            *"System Info"*)    run_system_info     ;;
            *)                  break               ;;
        esac
    done
}

# ── Preflight: make sure rofi and theme exist ────────────
if ! command -v rofi &>/dev/null; then
    echo "Error: rofi is not installed." >&2
    exit 1
fi

if [ ! -f "$THEME_FILE" ]; then
    # Fall back to running without a custom theme
    THEME_FILE=""
    rofi_menu() {
        local prompt="$1" mesg="${2:-}"
        shift 2
        local args=(-dmenu -i -p "$prompt" -kb-row-left "" -kb-move-char-back "" -kb-custom-1 "Left")
        [ -n "$mesg" ] && args+=(-mesg "$mesg")
        local ret=0
        rofi "${args[@]}" "$@" || ret=$?
        if [ "$ret" -eq 10 ] || [ "$ret" -eq 1 ]; then
            return 1
        fi
        return 0
    }
fi

main_menu
