/**
 * dwm-tudor Control Center — Rofi Theme
 *
 * Colours follow the polybar theme: dwm-controlcenter reads
 * ~/.config/polybar/themes/minimal/colors.ini (generated by theme-apply.sh
 * from themes.toml) and overrides the variables below at launch.
 * The values here are only the fallback (Nord) used when that file is missing.
 **/

/*****----- Global Properties -----*****/
* {
    bg:     #2e3440;   /* polybar bg       */
    bg-alt: #3b4252;   /* polybar bg-alt   */
    fg:     #d8dee9;   /* polybar fg       */
    fg-alt: #4c566a;   /* polybar fg-alt   */
    accent: #81a1c1;   /* polybar blue     */

    background-color: transparent;
    font: "JetBrainsMono Nerd Font 13";
}

/*****----- Main Window -----*****/
window {
    location:         center;
    anchor:           center;
    width:            42em;
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    8px;
    padding:          0;
}

/*****----- Main Box -----*****/
mainbox {
    spacing:          0;
    background-color: @bg;
    children:         [ "inputbar", "message", "listview" ];
}

/*****----- Input Bar -----*****/
inputbar {
    children:         [ prompt ];
    background-color: @bg-alt;
    padding:          14px 18px;
    border:           0 0 1px 0;
    border-color:     @fg-alt;
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 15";
}

/*****----- Message (status area) -----*****/
message {
    background-color: @bg;
    padding:          10px 18px;
    border:           0 0 1px 0;
    border-color:     @bg-alt;
}

textbox {
    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

/*****----- List View -----*****/
listview {
    background-color: @bg;
    columns:          1;
    lines:            10;
    dynamic:          true;
    scrollbar:        false;
    padding:          8px 0;
    fixed-height:     false;
}

/*****----- Elements -----*****/
element {
    padding:          10px 18px;
    background-color: transparent;
    text-color:       @fg;
    cursor:           pointer;
}

element selected.normal {
    background-color: @bg-alt;
    text-color:       @accent;
    border-radius:    0;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    cursor:           inherit;
}
