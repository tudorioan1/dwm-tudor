# Active theme — managed by theme-apply.sh, do not edit manually.
# Change the theme in ~/.config/dwm-tudor/themes.toml instead.
theme = Monochrome
window-theme = ghostty
window-height = 35
window-width = 100
background-opacity = 0.90
font-family = JetBrainsMono Nerd Font Mono
font-family-bold = JetBrainsMono Nerd Font Mono
font-family-italic = JetBrainsMono Nerd Font Mono
font-family-bold-italic = JetBrainsMono Nerd Font Mono
font-size = 14
gtk-titlebar = false
confirm-close-surface = false
window-decoration = false


#keybind = ctrl+up=scroll_page_lines:5
#keybind = ctrl+down=scroll_page_lines:-5 

keybind = ctrl+up=scroll_page_up
keybind = ctrl+down=scroll_page_down
