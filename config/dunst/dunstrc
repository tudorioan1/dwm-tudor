# Theme and visual styling are kept from dunstrc; functional settings are merged from vechi.

[global]
    # Display / geometry
    monitor = 0
    follow = none
    origin = top-right
    offset = (10, 50)
    width = 500
    height = (0, 300)
    scale = 0
    padding = 15
    horizontal_padding = 15
    text_icon_padding = 0
    corner_radius = 10
    corners = all
    notification_limit = 20
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    gap_size = 0

    # Progress bar
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0
    progress_bar_corners = all

    # Typography and message formatting
    font = JetBrainsMono Nerd Font 12
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    show_age_threshold = 60
    ignore_newline = no
    idle_threshold = 120

    # Theme colors
frame_color = "#FFFFFF"
    separator_color = auto

    # Notification behavior
    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    enable_posix_regex = false

    # Icons
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark
    icon_position = left
    min_icon_size = 16
    max_icon_size = 32
    icon_corner_radius = 0
    icon_corners = all

    # History
    sticky_history = yes
    history_length = 20

    # Context menu / integrations
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false

    # Platform compatibility
    force_xwayland = false
    force_xinerama = false

    # Mouse actions
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#080808"
    frame_color = "#777777"
    foreground = "#CCCCCC"
    timeout = 3
    highlight = "#b2b2b2"  # THEME: dunst_highlight_low
    default_icon = dialog-information

[urgency_normal]
    background = "#080808"
    frame_color = "#FFFFFF"
    foreground = "#CCCCCC"
    timeout = 5
    highlight = "#8cc85f"  # THEME: dunst_highlight_normal
    override_pause_level = 30
    default_icon = dialog-information

[urgency_critical]
    background = "#080808"
    foreground = "#CC3333"
    frame_color = "#CC3333"
    timeout = 0
    highlight = "#e3c78a"  # THEME: dunst_highlight_critical
    override_pause_level = 60
    default_icon = dialog-warning

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = false
    enable_pcre_regex = false
