#!/bin/sh
# dwm-session — shared entrypoint for both startx (.xinitrc) and a display
# manager (dwm.desktop). Runs autostart.sh explicitly (instead of relying on
# dwm's built-in autostart patch, which doesn't fire on every setup) and then
# execs dwm.
#
# Install this file to /usr/local/bin/dwm-session and:
#   sudo chmod +x /usr/local/bin/dwm-session

AUTOSTART="${XDG_DATA_HOME:-$HOME/.local/share}/dwm-titus/scripts/autostart.sh"

if [ -x "$AUTOSTART" ]; then
    "$AUTOSTART" &
fi

exec dwm
